<Window x:Class="LazBisPatcher.Gui.InstallReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review LazBis changes"
        Width="490" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}">
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Summary" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Text="MacroQuest folder" Foreground="{StaticResource Muted}" Margin="0,16,0,3" />
            <TextBlock x:Name="Folder" TextWrapping="Wrap" />
            <TextBlock x:Name="Guidance" Margin="0,16,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
            <Expander x:Name="Details" Header="File details" Foreground="{StaticResource Text}" Margin="0,16,0,0">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="18,6,0,0">
                    <TextBlock x:Name="FileList" TextWrapping="Wrap" FontFamily="Consolas" />
                </ScrollViewer>
            </Expander>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="DismissButton" Content="Cancel" Style="{StaticResource PatcherButton}" IsCancel="True" MinWidth="84" />
                <Button x:Name="ConfirmButton" Margin="8,0,0,0" Style="{StaticResource PatcherButton}"
                        Background="{StaticResource Gold}" Foreground="{StaticResource GoldInk}" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
