<Application x:Class="LazBisPatcher.Gui.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Panel" Color="#0A1418" />
        <SolidColorBrush x:Key="Border" Color="#2A8BA0" />
        <SolidColorBrush x:Key="Text" Color="#E8DCC8" />
        <SolidColorBrush x:Key="Gold" Color="#E8B84A" />
        <SolidColorBrush x:Key="ButtonFill" Color="#10303A" />
        <SolidColorBrush x:Key="Hover" Color="#17515F" />
        <SolidColorBrush x:Key="Muted" Color="#B8C8C5" />
        <SolidColorBrush x:Key="GoldInk" Color="#1A1208" />
        <Style x:Key="PatcherButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource ButtonFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
