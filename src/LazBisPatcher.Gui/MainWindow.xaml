<Window x:Class="LazBisPatcher.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LazBis Patcher"
        Width="700"
        Height="780"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent" Icon="Assets/LazBis.ico">

    <Border Margin="8" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.8" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="7,7,0,0" MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="  LazBisPatcher"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text}"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13" />
                    <Button x:Name="CloseButton"
                            Content="x"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Right"
                            Padding="0"
                            Background="Transparent"
                            Foreground="{StaticResource Text}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,18,20,20">
                <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="118" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18" MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource Border}" VerticalAlignment="Center" Margin="70,24,12,0" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="ProductTitle" Text="LAZBIS" Foreground="{StaticResource Text}" FontSize="30" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="INSTALLER / UPDATER" Foreground="{StaticResource Gold}" FontSize="12" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>
                <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource Border}" VerticalAlignment="Center" Margin="12,24,70,0" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MacroQuest Folder" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="MqDirTextBox" Grid.Column="1" Height="32" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8,5" TextChanged="MqDirTextBox_TextChanged" />
                <Button Grid.Column="2" x:Name="BrowseButton" Content="Browse..." Style="{StaticResource PatcherButton}" Margin="10,0,0,0" Click="BrowseButton_Click" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock x:Name="StatusLine" Text="Choose your MacroQuest folder." Foreground="{StaticResource Muted}" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionLine" Text="Installed unknown   |   Latest unknown" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>

            <Border x:Name="SelfUpdateBanner"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,8"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelfUpdateText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text}"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0"
                               Text="Checking patcher releases…" />
                    <Button x:Name="SelfUpdateButton"
                            Grid.Column="1"
                            Content="Update Patcher"
                            MinWidth="116"
                            Style="{StaticResource PatcherButton}"
                            Click="SelfUpdateButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Release notes" Foreground="{StaticResource Gold}" FontWeight="Bold" Margin="0,0,0,6" />
                <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Panel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PatchNotesText" Text="Check GitHub for update details." Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap" Padding="10" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Log" Foreground="{StaticResource Gold}" FontWeight="Bold" Margin="0,0,0,6" />
                <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Panel}">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" Foreground="{StaticResource Text}" FontFamily="Consolas" TextWrapping="Wrap" Padding="10" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CheckButton" Content="Check for Updates" Style="{StaticResource PatcherButton}" Margin="0,0,10,0" Padding="12,8" Click="CheckButton_Click" />
                <Button Grid.Column="1" x:Name="ActionButton" Content="Install or update LazBis" Style="{StaticResource PatcherButton}" Background="{StaticResource Gold}" Foreground="{StaticResource GoldInk}" FontSize="16" FontWeight="Bold" Height="48" Click="ActionButton_Click" />
            </Grid>
            <TextBlock Grid.Row="7" TextWrapping="Wrap" x:Name="ActionHint" Text="Choose your MacroQuest folder, then check for updates." Foreground="{StaticResource Muted}" Margin="0,8,0,12" />

            <DockPanel Grid.Row="8" LastChildFill="False" Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource Border}">
                    <Hyperlink NavigateUri="https://github.com/ThatSolo/lazbis" RequestNavigate="GitHubLink_RequestNavigate">
                        <Run Text="LazBis on GitHub" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="PatcherVersionText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" />
            </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
